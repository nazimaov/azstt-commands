# Скопируйте этот файл в .env и задайте свои значения.

# Токен доступа к административному API (раздел «Управление командами», модерация,
# экспорт). Минимум 16 символов. Никому не передавайте, не публикуйте в репозитории.
AZSTT_ADMIN_TOKEN=replace-with-a-long-random-string

# Опционально — по умолчанию используются значения ниже.
# AZSTT_DATABASE_URL=sqlite:///./data/azstt.db
# AZSTT_AUDIO_DIR=./data/audio
# AZSTT_HOST=127.0.0.1
# AZSTT_PORT=8766
# AZSTT_MAX_UPLOAD_MB=15
# AZSTT_MAX_DURATION_SEC=8.0
# AZSTT_MIN_DURATION_SEC=0.2
# Домены фронтенда для CORS при раздельном запуске (через запятую). Не нужно, если
# фронтенд собран и раздаётся тем же backend-процессом (см. README).
# AZSTT_CORS_ORIGINS=http://localhost:5173
